# Copy this file to .env and set your server-side OpenAI API key.
# Never add EXPO_PUBLIC_ to a private key or commit the populated .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Must match the Firebase project configured in src/firebase/firebase.ts.
FIREBASE_PROJECT_ID=gentalk-595d2

# Development only: false disables the AI request limit locally.
# Production always enforces the limit regardless of this value.
AI_RATE_LIMIT_ENABLED=true
