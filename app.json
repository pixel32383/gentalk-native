{
  "expo": {
    "name": "gentalk-native",
    "slug": "pixel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gentalknative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.gentalk.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 이미지를 변경하기 위해 사진에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": "GENTALK이 말하기 연습을 위해 마이크를 사용합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#914523"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GENTALK이 말하기 연습을 위해 마이크를 사용합니다.",
          "speechRecognitionPermission": "GENTALK이 말한 내용을 텍스트로 바꾸기 위해 음성 인식을 사용합니다.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "029db317-67c0-4bdc-87e3-1381c3f10855"
      }
    },
    "owner": "pixel3238s-team"
  }
}
