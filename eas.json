{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-unlimited": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "GENTALK_API_ORIGIN": "https://gentalk-pixel3238--unlimited.expo.app",
        "EXPO_PUBLIC_GENTALK_TEST_RATE_LIMIT_CONTROLS": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
